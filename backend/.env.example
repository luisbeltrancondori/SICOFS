# ==============================================================================
# SALUD MONTERO - BACKEND CONFIGURATION
# ==============================================================================

# Puerto del servidor API
PORT=3001

# Conexión a Base de Datos SQL Server
DB_SERVER=SICOFS-SERVER\SUS
DB_DATABASE=BDTemporal
DB_USER=sa
DB_PASSWORD=your_password_here
# Leave DB_PORT unset to resolve the named instance through SQL Server Browser.
# If using a fixed TCP port, set DB_SERVER to the host (without \SUS) and
# DB_PORT to the actual TCP port configured for the SUS instance.
